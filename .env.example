# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Supabase — find these in your Supabase project dashboard under Settings > API
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Vite exposes the variables below to the browser (must be prefixed with VITE_)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Lovable API key — find this in your Lovable account settings
LOVABLE_API_KEY="your-lovable-api-key"
